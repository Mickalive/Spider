  "sampling": {
    "n_total": 40,
    "n_states": 4,
    "n_reps_per_state": 10,
    "seed": 44,
    "shuffle_order": true,
    "inter_request_delay_ms": "0-200ms",
    "synthetic_jitter": false
  },
  "artifacts": [
    {
      "path": "raw_observations.json",
      "role": "raw",
      "description": "40 HTTP observations with status, headers, body, fingerprint"
